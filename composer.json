    "type": "library",
    "version": "0.5.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriel Serwas",
            "email": "post@gabrielserwas.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MrCodefinger\\TwelveTones\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
